# Скопировать в .env и заполнить реальными значениями.
# Этот файл — единственный источник переменных для всего деплоя
# (compose читает его и для db/backend/migrate, и для интерполяции ${...} в yaml).

ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# ---- PostgreSQL ----
DB_HOST=db
DB_PORT=5432
DB_USER=pocketkeeper_user
DB_PASSWORD=change_me_strong_password
POSTGRES_DB=pocketkeeper_db
DB_ECHO=False

# ---- Аутентификация ----
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# ---- Почта (для reset password и т.д.) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PocketKeeper

# ---- CORS ----
# Т.к. nginx отдаёт frontend и backend с одного домена (frontend на "/",
# backend на "/api/"), запросы идут same-origin и CORS почти не участвует.
# Значение ниже — подстраховка на случай прямых обращений к API с фронта.
CORS_ALLOW_ORIGINS=["https://your-domain.com"]

LOG_LEVEL=INFO

# ---- Frontend (build-time) ----
# Относительный путь — работает "из коробки" благодаря общему домену через nginx.
# Меняйте на абсолютный URL, только если backend вынесен на отдельный (под)домен.
VITE_API_URL=/api/v1

# ---- Домен (для памятки в nginx-конфиге / certbot) ----
DOMAIN=your-domain.com
