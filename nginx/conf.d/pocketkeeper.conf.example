upstream backend_upstream {
    server backend:8000;
}

upstream frontend_upstream {
    server frontend:80;
}

# Доп. защита на уровне edge поверх лимитов в самом приложении (slowapi)
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=addr_limit:10m;

# Отключаем версию nginx в заголовках
server_tokens off;

server {
    listen 80;
    listen [::]:80;

    # ЗАМЕНИТЬ на реальный домен
    server_name your-domain.com;

    # Ограничение размера тела запроса (для загрузки файлов)
    client_max_body_size 10m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Нужно для выпуска/продления сертификата Let's Encrypt (certbot webroot)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # ---- Пока нет TLS-сертификата, этот блок обслуживает трафик напрямую ----
    # Как только сертификат выпущен (см. README) — закомментировать location
    # /api/ и / ниже, раскомментировать "return 301" и HTTPS-server внизу файла.

    location /api/ {
        limit_req zone=api_limit burst=40 nodelay;

        proxy_pass http://backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://frontend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # return 301 https://$host$request_uri;
}

